# Docker environment — service names as hostnames
DATABASE_URL=postgresql+asyncpg://ads_user:ads_password@postgres:5432/ads_supervisor
DATABASE_SYNC_URL=postgresql://ads_user:ads_password@postgres:5432/ads_supervisor

# Security
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI provider (Groq)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ad_embeddings

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (screenshots storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ad-screenshots
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_SECURE=false

# Frontend
FRONTEND_URL=http://localhost:5173

# Behavior
CONFIDENCE_THRESHOLD=65
AUTO_ANALYZE=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO
ENVIRONMENT=production
