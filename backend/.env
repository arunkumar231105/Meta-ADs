# Database
DATABASE_URL=postgresql+asyncpg://ads_user:ads_password@localhost:5432/ads_supervisor
DATABASE_SYNC_URL=postgresql://ads_user:ads_password@localhost:5432/ads_supervisor

# Security
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anthropic
ANTHROPIC_API_KEY=sk-ant-placeholder-replace-when-you-have-the-key
CLAUDE_MODEL=claude-sonnet-4-5

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ad_embeddings

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_URL=http://localhost:5173

# Behavior
CONFIDENCE_THRESHOLD=65
AUTO_ANALYZE=true
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO
ENVIRONMENT=development
